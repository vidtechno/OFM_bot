# @BotFather orqali olinadi
TELEGRAM_BOT_TOKEN=

# Supabase project Settings > API bo'limidan olinadi
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PHASE 1 da optional; keyingi AI manager bosqichida ishlatiladi
OPENAI_API_KEY=

# Vergul bilan ajratilgan immutable Telegram user IDlar
ADMIN_TELEGRAM_IDS=6117815120

# Bot ishlash rejimi: development uchun 'polling', production uchun 'webhook'
BOT_MODE=polling

# Webhook xavfsizlik tokeni (Telegram X-Telegram-Bot-Api-Secret-Token uchun random string)
TELEGRAM_WEBHOOK_SECRET=

# Ixtiyoriy: Agar kiritilmasa, SUPABASE_URL orqali avtomatik aniqlanadi
# TELEGRAM_WEBHOOK_URL=https://<PROJECT_REF>.supabase.co/functions/v1/telegram-webhook

NODE_ENV=development
LOG_LEVEL=info

